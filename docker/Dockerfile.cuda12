# Control environment: CUDA 12.x (no FP64 emulation in cuBLAS).
#
# NOTE: The default is 12.9.1, not 12.4.1. CUDA 12.4 predates Blackwell (sm_120,
# e.g. RTX 50xx); cuBLAS/NVRTC 12.4 cannot emit native code for it, so it would
# run via PTX JIT or fail. Override with CUDA12_BASE_IMAGE if you need 12.4.1
# on a pre-Blackwell GPU.
ARG BASE_IMAGE=nvidia/cuda:12.9.1-devel-ubuntu22.04
FROM ${BASE_IMAGE}

ARG CUPY_VERSION=14.2.0
# 0: use the prebuilt wheel (dlopens the container's CUDA libs)
# 1: build CuPy from source against /usr/local/cuda (slow, ~20+ min)
ARG CUPY_FROM_SOURCE=0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:${PATH} \
    CUDA_PATH=/usr/local/cuda \
    CUPY_CACHE_DIR=/tmp/cupy_cache \
    MPLCONFIGDIR=/tmp/matplotlib

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv ${VIRTUAL_ENV} && pip install --no-cache-dir --upgrade pip

COPY docker/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

RUN if [ "${CUPY_FROM_SOURCE}" = "1" ]; then \
        pip install --no-cache-dir --no-binary cupy "cupy==${CUPY_VERSION}"; \
    else \
        pip install --no-cache-dir "cupy-cuda12x==${CUPY_VERSION}"; \
    fi

# Pip-installed CUDA libraries (nvidia-cublas-* etc.) would shadow the toolkit's cuBLAS.
RUN if pip list 2>/dev/null | grep -i -E '^nvidia-(cublas|cuda-runtime)'; then \
        echo "ERROR: pip-installed CUDA libraries found; they would shadow the toolkit cuBLAS" >&2; exit 1; \
    fi

WORKDIR /workspace
